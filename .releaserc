{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogFile": "dist/CHANGELOG.md" }],
    ["@semantic-release/exec", {
      "prepareCmd": "python scripts/ci/build_bundle.py --channel stable --version ${nextRelease.version}"
    }],
    ["@semantic-release/github", {
      "assets": [
        { "path": "dist/*.bin", "label": "ESP32-S3 application firmware" },
        { "path": "dist/*.zip" },
        { "path": "dist/manifest.json" },
        { "path": "dist/SHA256SUMS" },
        { "path": "dist/CHANGELOG.md" }
      ],
      "successComment": false,
      "failComment": false,
      "failTitle": false,
      "releasedLabels": false
    }]
  ]
}
